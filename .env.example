# Context Pager Configuration
# Copy to .env and fill in values.

# ── Relay (AWS) — used by `pager serve` ──────────────────────
PAGER_RELAY_HOST=0.0.0.0
PAGER_RELAY_PORT=8000
PAGER_MCP_PATH=/mcp
PAGER_BRIDGE_PATH=/bridge
PAGER_SQLITE_DB=users.db
PAGER_PUBLIC_URL=https://context-pager.duckdns.org
PAGER_API_KEY_PREFIX=pgr_
PAGER_RATE_LIMIT_CALLS_PER_HOUR=100
PAGER_MAX_BRIDGES_PER_KEY=2
PAGER_SIGNUP_PER_IP_PER_DAY=5

# ── Bridge (laptop) — used by `pager bridge` ─────────────────
PAGER_ROOT=~/.pager/docs
PAGER_DB=~/.pager/pager.db
PAGER_TELEMETRY_DB=~/.pager/telemetry.db
# Two-key model: bridge key authenticates the WSS channel,
# agent key authenticates MCP calls to the relay.
PAGER_BRIDGE_KEY=pgr_bridge_...
PAGER_BRIDGE_WS_URL=wss://context-pager.duckdns.org/bridge
# Agent key (used by the agent's MCP config, not the bridge).
# Documented here; actual usage lives in examples/goldfish_agent.
PAGER_AGENT_KEY=pgr_agent_...
# Lite mode: swap heavy models for light ones (bge-small + truncation).
# PII masking (Presidio) stays enabled in both modes.
PAGER_LITE=false
PAGER_LOCAL_MCP_HOST=127.0.0.1
PAGER_LOCAL_MCP_PORT=8000

# ── Models (bridge) ─────────────────────────────────────────
PAGER_EMBEDDING_MODEL=BAAI/bge-m3
PAGER_LLMLINGUA_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
PAGER_CHUNK_TOKENS=512
PAGER_MAX_RETURN_TOKENS=2048

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
